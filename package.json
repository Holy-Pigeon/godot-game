{
  "name": "terminus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node packages/sim/src/cli.ts",
    "server": "node packages/server/src/main.ts",
    "dev": "vite --config packages/client/vite.config.ts",
    "build": "vite build --config packages/client/vite.config.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "e2e": "node packages/server/test/e2e.ts",
    "migrate": "MIGRATE=1 node packages/server/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "playwright-core": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
